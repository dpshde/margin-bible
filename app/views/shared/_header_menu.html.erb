<% account = local_assigns.fetch(:account, true) %>
<details class="topbar-menu" data-controller="theme">
  <summary class="icon-btn" title="Menu" aria-label="Menu">
    <%= ph_icon("dots-three", size: 20) %>
  </summary>
  <div class="menu-panel" onclick="if (event.target.closest('button, a')) this.closest('details').removeAttribute('open')">
    <button type="button" class="menu-item" data-theme-pref="light" data-action="click->theme#choose">Light</button>
    <button type="button" class="menu-item" data-theme-pref="system" data-action="click->theme#choose">System</button>
    <button type="button" class="menu-item" data-theme-pref="dark" data-action="click->theme#choose">Dark</button>
    <% if account %>
      <hr class="dock-sep">
      <%= render "shared/account_nav", appearance: :menu %>
    <% end %>
  </div>
</details>
