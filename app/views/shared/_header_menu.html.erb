<% account = local_assigns.fetch(:account, true) %>
<% export = local_assigns.fetch(:export, false) %>
<details class="topbar-menu" data-controller="theme">
  <summary class="icon-btn" title="Menu" aria-label="Menu">
    <%= ph_icon("dots-three", size: 20) %>
  </summary>
  <div class="menu-panel" onclick="if (event.target.closest('button, a') && !event.target.closest('.menu-item-theme')) this.closest('details').removeAttribute('open')">
    <button type="button" class="menu-item menu-item-theme" data-action="click->theme#toggle" aria-label="Toggle appearance">
      <span class="theme-toggle-face theme-toggle-when-light">
        <%= ph_icon("sun", size: 18) %>
        <span>Light</span>
      </span>
      <span class="theme-toggle-face theme-toggle-when-dark">
        <%= ph_icon("moon", size: 18) %>
        <span>Dark</span>
      </span>
    </button>
    <% if export %>
      <hr class="dock-sep">
      <%= render "shared/export_link", appearance: :menu %>
    <% end %>
    <% if account %>
      <hr class="dock-sep">
      <%= render "shared/account_nav", appearance: :menu %>
    <% end %>
  </div>
</details>
