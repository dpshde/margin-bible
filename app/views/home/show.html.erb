<% content_for :title, "Notes" %>

<div class="inbox" data-controller="search">
  <% unless hotwire_native_app? %>
    <header class="topbar">
      <div class="topbar-side"></div>
      <h1 class="topbar-title">Notes</h1>
      <div class="topbar-actions">
        <%= link_to "Sign in", new_session_path, class: "ghost quiet" %>
      </div>
    </header>
  <% end %>

  <main class="inbox-main">
    <% if @continue %>
      <p class="inbox-continue">
        <%= link_to "Continue #{@continue.label}", read_path(@continue.slug) %>
      </p>
    <% end %>

    <%= render "shared/jump" %>

    <% if @sections.empty? %>
      <p class="inbox-empty">No notes yet. Open a passage and write under a verse — they’ll show up here newest first.</p>
    <% else %>
      <% @sections.each do |section| %>
        <h2 class="inbox-day"><%= section[:label] %></h2>
        <% section[:notes].each do |note| %>
          <%= link_to inbox_note_path(note), class: "inbox-card" do %>
            <p class="inbox-card-title"><%= note.passage.label %></p>
            <% if note.empty_content? %>
              <p class="inbox-card-empty">Empty note</p>
            <% else %>
              <div class="inbox-preview">
                <% Array(note.blocks).each do |block| %>
                  <p class="preview-line" style="--depth: <%= block["indent"].to_i %>"><%= wiki_note_html(block["text"], links: false) %></p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </main>
</div>
