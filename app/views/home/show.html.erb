<% content_for :title, "Notes" %>

<div class="inbox" data-controller="search inbox" data-inbox-signed-in-value="<%= signed_in? %>">
  <% unless hotwire_native_app? %>
    <header class="topbar">
      <div class="topbar-side"></div>
      <h1 class="topbar-title">Notes</h1>
      <div class="topbar-actions">
        <%= render "shared/theme_seg" %>
        <%= render "shared/account_nav", appearance: :quiet %>
      </div>
    </header>
  <% end %>

  <main class="inbox-main">
    <p class="inbox-continue" data-inbox-target="continue" <%= "hidden" unless @continue %>>
      <% if @continue %>
        <%= link_to "Continue #{@continue.label}", read_path(@continue.slug) %>
      <% else %>
        <a href="/"></a>
      <% end %>
    </p>

    <%= render "shared/jump" %>

    <div data-inbox-target="list">
      <% if @sections.empty? %>
        <p class="inbox-empty">No notes yet. Open a passage and write under a verse — they’ll show up here newest first.</p>
      <% else %>
        <% @sections.each do |section| %>
          <h2 class="inbox-day <%= "is-bookmarks" if section[:kind] == :bookmarks %>"><%= section[:label] %></h2>
          <% if section[:kind] == :bookmarks %>
            <% Array(section[:groups]).each do |group| %>
              <details class="inbox-book">
                <summary class="inbox-book-summary">
                  <span class="inbox-mark" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
                      <path d="M4 2.25h8v11.1L8 11.1 4 13.35z" />
                    </svg>
                  </span>
                  <span class="inbox-book-name"><%= group[:label] %></span>
                  <span class="inbox-book-count"><%= group[:notes].size %></span>
                  <%= ph_icon("caret-right", size: 14) %>
                </summary>
                <% group[:notes].each do |note| %>
                  <%= render "home/inbox_card", note: note, show_mark: false %>
                <% end %>
              </details>
            <% end %>
          <% else %>
            <% section[:notes].each do |note| %>
              <%= render "home/inbox_card", note: note %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
