<% content_for :title, "Sign in" %>
<% unless hotwire_native_app? %>
  <header class="topbar">
    <div class="topbar-side">
      <%= link_to root_path, class: "icon-btn", title: "Notes", "aria-label": "Notes" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M3 4.5h10" />
          <path d="M3 8h10" />
          <path d="M3 11.5h7" />
        </svg>
      <% end %>
    </div>
    <h1 class="topbar-title">Sign in</h1>
    <div class="topbar-actions">
      <%= render "shared/header_menu", account: false %>
    </div>
  </header>
<% end %>

<main class="page" data-controller="sign-in">
  <p class="lede">A magic link claims this library. Notes already on this device stay put.</p>

  <% if @dev_login_path %>
    <%= link_to "Open sign-in link", @dev_login_path, class: "primary" %>
  <% end %>

  <%= form_with url: session_path, method: :post do %>
    <label class="sr-only" for="email">Email</label>
    <input id="email" name="email" type="email" required autocomplete="username webauthn" placeholder="you@example.com">
    <button type="submit" class="primary">Email me a link</button>
  <% end %>

  <p class="auth-or">or</p>

  <div class="auth-passkey">
    <div class="auth-passkey-use" data-sign-in-target="use" hidden>
      <%= passkey_sign_in_button "Use a passkey", session_passkey_path,
            options: @authentication_options,
            mediation: "conditional",
            class: "primary" %>
    </div>

    <div class="auth-passkey-create" data-sign-in-target="create">
      <%= passkey_registration_button "Create a passkey", session_passkey_registration_path,
            options: @registration_options,
            class: "primary" %>
      <p class="muted">Claims the notes on this device.</p>
    </div>

    <button type="button" class="text-btn auth-passkey-switch" data-sign-in-target="useSwitch" data-action="click->sign-in#preferUse">
      I already have a passkey
    </button>
    <button type="button" class="text-btn auth-passkey-switch" hidden data-sign-in-target="createSwitch" data-action="click->sign-in#preferCreate">
      Create a new passkey
    </button>
  </div>
</main>
