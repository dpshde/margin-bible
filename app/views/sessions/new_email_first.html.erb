<% content_for :title, "Get into Margin" %>
<% unless hotwire_native_app? %>
  <header class="topbar">
    <div class="topbar-side">
      <%= link_to root_path, class: "icon-btn", title: "Notes", "aria-label": "Notes" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M3 4.5h10" />
          <path d="M3 8h10" />
          <path d="M3 11.5h7" />
        </svg>
      <% end %>
    </div>
    <h1 class="topbar-title">Sign in</h1>
    <div class="topbar-actions">
      <%= render "shared/header_menu", account: false %>
    </div>
  </header>
<% end %>

<main class="page" data-controller="sign-in">
  <h1>Get into Margin</h1>

  <% if @dev_login_path %>
    <%= link_to "Open sign-in link", @dev_login_path, class: "primary" %>
  <% end %>

  <%= form_with url: session_path, method: :post do %>
    <%= hidden_field_tag :signin, "email" %>
    <label class="sr-only" for="email">Email</label>
    <input id="email" name="email" type="email" required autofocus autocomplete="username webauthn" placeholder="you@example.com">
    <p class="muted auth-help">
      New here?
      <button type="button" class="text-btn" data-action="sign-in#startRegistration">Create a passkey</button>
      to claim notes on this device. Already have an account? Enter your email and we'll send a one-time link.
    </p>
    <button type="submit" class="primary">Let's go</button>
  <% end %>

  <div class="auth-passkey-use">
    <%= passkey_sign_in_button "Sign in with a passkey", session_passkey_path,
          options: @authentication_options,
          mediation: "conditional",
          auto_start: true,
          class: "text-btn" %>
  </div>

  <div class="auth-passkey-create" hidden data-sign-in-target="register">
    <%= passkey_registration_button "Create a passkey", session_passkey_registration_path,
          options: @registration_options,
          hidden: true %>
  </div>
</main>
