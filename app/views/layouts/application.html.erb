<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Margin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Margin">
    <meta name="description" content="Read Scripture. Write in the margin. margin.bible">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f6f5f2">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body>
    <% if notice %><p class="flash" role="status"><%= notice %></p><% end %>
    <% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>
    <%= yield %>
  </body>
</html>
