<% content_for :title, (@passage.kind == "chapter" ? @chapter.label : @passage.label) %>
<% content_for :head do %>
  <% if @prev %><link rel="prefetch" href="<%= read_path(@prev.slug) %>"><% end %>
  <% if @next %><link rel="prefetch" href="<%= read_path(@next.slug) %>"><% end %>
<% end %>
<%
  span_start = @passage.verse_start
  span_end = @passage.span_end
  range_selected = @passage.range?
  single_selected = @passage.kind == "verse"
  range_slug = range_selected ? @passage.slug : nil
%>

<div
  data-controller="reader search"
  data-action="pointerdown->reader#pressStart"
  data-reader-focus-value="<%= @focus_verse %>"
  data-reader-chapter-slug-value="<%= @chapter.slug %>"
  data-reader-notes-url-value="<%= notes_path %>"
  data-reader-book-label-value="<%= Margin::Books.name_for(@chapter.book) %>"
  data-reader-chapter-value="<%= @chapter.chapter %>"
  data-reader-prev-url-value="<%= @prev ? read_path(@prev.slug) : "" %>"
  data-reader-next-url-value="<%= @next ? read_path(@next.slug) : "" %>"
  data-reader-signed-in-value="<%= signed_in? %>"
  data-reader-passage-slug-value="<%= @passage.slug %>"
  data-reader-export-url-value="<%= export_path %>"
  data-reader-book-value="<%= @chapter.book %>"
  <% if span_start %>
    data-reader-span-start-value="<%= span_start %>"
    data-reader-span-end-value="<%= span_end %>"
  <% end %>
>
  <% unless hotwire_native_app? %>
    <header class="topbar" data-controller="chrome" data-chrome-edge-value="top" data-action="chrome:reveal->chrome#show">
      <div class="topbar-side">
        <%= link_to root_path, class: "icon-btn inbox-link", title: "Notes", "aria-label": "Notes inbox", data: { action: "click->reader#flushPending" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M3 4.5h10" />
            <path d="M3 8h10" />
            <path d="M3 11.5h7" />
          </svg>
        <% end %>
      </div>
      <h1 class="topbar-title" data-reader-target="title"><%= @passage.kind == "chapter" ? @chapter.label : @passage.label %></h1>
      <div class="topbar-actions">
        <button
          type="button"
          class="icon-btn header-quiet-button"
          data-reader-target="quietToggle"
          data-action="click->reader#toggleQuiet"
          aria-pressed="false"
          aria-label="Focus"
          title="Focus"
        >
          <%= ph_icon("flower-lotus", size: 20) %>
        </button>
        <button
          type="button"
          class="icon-btn header-copy-button"
          data-reader-target="copyButton"
          data-action="click->reader#copyPassage"
          aria-label="Copy chapter text and notes"
          title="Copy chapter"
        >
          <svg class="copy-idle" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
            <rect x="9" y="9" width="10" height="10" rx="2"></rect>
            <path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
          </svg>
          <span class="copy-done" aria-hidden="true"><%= ph_icon("check", size: 18) %></span>
        </button>
        <details class="topbar-menu reader-actions-menu" data-controller="dock-menu" data-action="toggle->dock-menu#closed">
          <summary class="icon-btn" aria-label="Reader actions" title="Reader actions">
            <%= ph_icon("dots-three", size: 20) %>
          </summary>
          <div class="menu-panel reader-actions-panel" data-action="click->dock-menu#choose">
            <%= render "reader/actions", include_recent: false %>
          </div>
        </details>
      </div>
    </header>
  <% end %>

  <main class="reader">
    <div class="reader-chrome" data-controller="chrome" data-action="chrome:reveal->chrome#show">
      <%= render "reader/trail" %>
      <div class="chrome-bar">
        <%= render "shared/jump" %>
        <%= render "reader/dock" %>
      </div>
    </div>

    <section class="chapter-tray" data-reader-target="chapterTray" data-action="keydown->reader#closeChapterOnEscape" <%= "hidden" unless params[:chapter_note] %>>
      <%= render "reader/note_editor", slug: @chapter.slug, note: @chapter_note, label: "Chapter note · #{@chapter.label}", closable: true %>
    </section>

    <article class="chapter">
      <% @verses.each do |verse| %>
        <% vslug = @chapter.verse_slug(verse.verse) %>
        <% covering = @notes_by_verse[verse.verse] || [] %>
        <% exact = covering.find { |note| note.slug == vslug } %>
        <% range_note = range_slug && covering.find { |note| note.slug == range_slug } %>
        <% in_span = span_start && verse.verse >= span_start && verse.verse <= span_end %>
        <% is_end = range_selected && verse.verse == span_end %>
        <% is_single_open = single_selected && verse.verse == span_start %>
        <% trays_open = is_single_open || is_end %>
        <div
          class="verse <%= "has-note" if covering.any? %> <%= "is-open" if trays_open %> <%= "is-span" if in_span %>"
          id="v<%= verse.verse %>"
          data-verse="<%= verse.verse %>"
          data-slug="<%= vslug %>"
        >
          <% if verse.heading.present? %>
            <h2 class="section-head <%= "spaced" if verse.verse > 1 %>"><%= verse.heading %></h2>
          <% end %>
          <button type="button" class="verse-press" data-action="click->reader#openVerse">
            <span class="vnum"><%= verse.verse %></span>
            <span class="vtext"><%= verse.text %></span>
          </button>
          <% if covering.any? && !trays_open %>
            <div class="rail" aria-hidden="true"></div>
          <% end %>
          <% covering.each do |note| %>
            <section class="note-card">
              <div class="note-tray" data-reader-target="tray" data-note-slug="<%= note.slug %>" <%= "hidden" unless trays_open %>>
                <%= render "reader/note_editor", slug: note.slug, note: note, label: note.passage.label %>
              </div>
            </section>
          <% end %>
          <% if is_end && range_slug && range_note.nil? %>
            <div
              class="note-tray"
              data-reader-target="tray"
              data-range-composer
              data-range-slug="<%= range_slug %>"
            >
              <%= render "reader/note_editor", slug: range_slug, note: nil, label: @passage.label %>
            </div>
          <% end %>
          <% unless exact %>
            <div
              class="note-tray"
              data-reader-target="tray"
              data-verse-composer
              <%= "hidden" unless is_single_open %>
            >
              <%= render "reader/note_editor", slug: vslug, note: nil, label: nil %>
            </div>
          <% end %>
        </div>
      <% end %>
    </article>

    <template data-reader-target="rangeTemplate">
      <div class="note-tray" data-range-composer hidden>
        <%= render "reader/note_editor", slug: "range.placeholder", note: nil, label: "Passage" %>
      </div>
    </template>

    <nav class="pager">
      <% if @prev %><%= link_to "← #{@prev.label}", read_path(@prev.slug), data: { turbo_prefetch: true } %><% end %>
      <% if @next %><%= link_to "#{@next.label} →", read_path(@next.slug), data: { turbo_prefetch: true } %><% end %>
    </nav>
  </main>
  <div class="reader-veil" aria-hidden="true"></div>
</div>
