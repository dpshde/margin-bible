<% content_for :title, @chapter.label %>

<div
  data-controller="reader search"
  data-reader-focus-value="<%= @focus_verse %>"
  data-reader-chapter-slug-value="<%= @chapter.slug %>"
  data-reader-notes-url-value="<%= notes_path %>"
>
  <% unless hotwire_native_app? %>
    <header class="topbar">
      <div class="topbar-side">
        <% if @prev %>
          <%= link_to "‹ #{@prev.label}", read_path(@prev.slug), class: "ghost", data: { turbo_action: "advance" } %>
        <% end %>
      </div>
      <h1 class="topbar-title"><%= @chapter.label %></h1>
      <div class="topbar-actions">
        <details class="topbar-menu">
          <summary class="icon-btn" title="Menu" aria-label="Menu">≡</summary>
          <div class="menu-panel" onclick="if (event.target.closest('button, a')) this.closest('details').removeAttribute('open')">
            <button type="button" class="menu-item" data-action="click->reader#share" data-reader-route-bible-param="<%= @route_bible_url %>">Share</button>
            <button type="button" class="menu-item <%= "is-on" if @chapter_note %>" data-action="click->reader#toggleChapter">Chapter note</button>
            <button type="button" class="menu-item" data-action="click->reader#toggleExpand" <%= "disabled" unless @verse_notes.any? %>>Expand notes</button>
            <%= link_to "Sign in", new_session_path, class: "menu-item" %>
          </div>
        </details>
      </div>
    </header>
  <% end %>

  <main class="reader">
    <form class="jump" data-action="submit->search#go" data-turbo="false">
      <label class="sr-only" for="q">Jump to passage</label>
      <input
        id="q"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="John 3:16"
        data-search-target="input"
        data-action="input->search#suggest"
      >
      <ul class="suggest" data-search-target="list" hidden></ul>
    </form>

    <section class="chapter-tray" data-reader-target="chapterTray" <%= "hidden" unless params[:chapter_note] %>>
      <%= render "reader/note_editor", slug: @chapter.slug, note: @chapter_note, label: "Chapter note · #{@chapter.label}" %>
    </section>

    <article class="chapter">
      <% @verses.each do |verse| %>
        <% vslug = @chapter.verse_slug(verse.verse) %>
        <% covering = @notes_by_verse[verse.verse] || [] %>
        <% exact = covering.find { |note| note.slug == vslug } %>
        <% open = @focus_verse == verse.verse %>
        <div
          class="verse <%= "has-note" if covering.any? %> <%= "is-open" if open %>"
          id="v<%= verse.verse %>"
          data-verse="<%= verse.verse %>"
          data-slug="<%= vslug %>"
        >
          <% if verse.heading.present? %>
            <h2 class="section-head <%= "spaced" if verse.verse > 1 %>"><%= verse.heading %></h2>
          <% end %>
          <button type="button" class="verse-press" data-action="click->reader#openVerse">
            <span class="vnum"><%= verse.verse %></span>
            <span class="vtext"><%= verse.text %></span>
          </button>
          <% if covering.any? && !open %>
            <div class="rail" aria-hidden="true"></div>
          <% end %>
          <% covering.each do |note| %>
            <section class="note-card">
              <div class="note-tray" data-reader-target="tray" <%= "hidden" unless open %>>
                <%= render "reader/note_editor", slug: note.slug, note: note, label: note.passage.label %>
              </div>
              <div class="note-preview" data-reader-target="preview" hidden>
                <p class="preview-label"><%= note.passage.label %></p>
                <div class="preview-body">
                  <% Array(note.blocks).each do |block| %>
                    <p class="preview-line" style="--depth: <%= block["indent"].to_i %>"><%= wiki_note_html(block["text"]) %></p>
                  <% end %>
                </div>
              </div>
            </section>
          <% end %>
          <% unless exact %>
            <div class="note-tray" data-reader-target="tray" <%= "hidden" unless open %>>
              <%= render "reader/note_editor", slug: vslug, note: nil, label: nil %>
            </div>
          <% end %>
        </div>
      <% end %>
    </article>

    <nav class="pager">
      <% if @prev %><%= link_to "← #{@prev.label}", read_path(@prev.slug) %><% end %>
      <% if @next %><%= link_to "#{@next.label} →", read_path(@next.slug) %><% end %>
    </nav>
  </main>
</div>
