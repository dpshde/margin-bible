<div class="dock-pane" data-dock-menu-target="pane" data-pane="root">
  <% include_recent = local_assigns.fetch(:include_recent, false) %>
  <% if include_recent && @trail.any? %>
    <nav class="dock-recent" aria-label="Recent passages">
      <% @trail.each do |passage| %>
        <%= link_to read_path(passage.slug), class: "dock-item", data: { turbo_prefetch: true } do %>
          <%= ph_icon("clock-counter-clockwise") %>
          <span><%= passage.label %></span>
        <% end %>
      <% end %>
    </nav>
    <hr class="dock-sep">
  <% end %>
  <div class="dock-toggles">
    <button type="button" class="dock-item" data-reader-target="quietToggle" data-action="click->reader#toggleQuiet" aria-pressed="false">
      <%= ph_icon("flower-lotus") %>
      <span>Focus</span>
      <span class="dock-check" aria-hidden="true"><%= ph_icon("check") %></span>
    </button>
    <button type="button" class="dock-item <%= "is-on" if @chapter_note %>" data-action="click->reader#toggleChapter" aria-pressed="<%= @chapter_note ? "true" : "false" %>">
      <%= ph_icon("note-pencil") %>
      <span>Chapter note</span>
      <span class="dock-check" aria-hidden="true"><%= ph_icon("check") %></span>
    </button>
    <button type="button" class="dock-item" data-action="click->reader#toggleExpand" aria-pressed="false" <%= "disabled" unless @verse_notes.any? %>>
      <%= ph_icon("arrows-out") %>
      <span>Expand notes</span>
      <span class="dock-check" aria-hidden="true"><%= ph_icon("check") %></span>
    </button>
    <button type="button" class="dock-item" data-reader-target="numsToggle" data-action="click->reader#toggleNums" aria-pressed="false">
      <%= ph_icon("list-numbers") %>
      <span>Hide verse numbers</span>
      <span class="dock-check" aria-hidden="true"><%= ph_icon("check") %></span>
    </button>
  </div>
  <div class="dock-theme">
    <%= render "shared/theme_seg" %>
    <%= render "shared/face_seg" %>
  </div>
</div>
