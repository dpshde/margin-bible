<label class="sr-only" for="note-<%= slug %>"><%= label || "Note" %></label>
<textarea
  id="note-<%= slug %>"
  class="note-input"
  rows="3"
  placeholder="Write a note…"
  data-slug="<%= slug %>"
  data-action="input->reader#autosave"
><%= note&.body_text %></textarea>
<p class="tray-meta">
  <a
    class="tray-external"
    href="<%= route_bible_url(slug) %>"
    target="_blank"
    rel="noreferrer"
    aria-label="Open on route.bible"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M5 3h8v8" />
      <path d="M13 3 3 13" />
    </svg>
  </a>
</p>
