<%
  display_label = local_assigns[:label].presence || Margin::Passage.parse(slug)&.label
  editor_blocks = Array(note&.blocks)
  editor_blocks = [ { "id" => "b_#{SecureRandom.hex(4)}", "indent" => 0, "text" => "", "bullet" => true } ] if editor_blocks.empty?
%>
<div
  class="outliner"
  data-controller="outliner"
  data-outliner-slug-value="<%= slug %>"
  data-slug="<%= slug %>"
  data-action="outliner:change->reader#autosave"
>
  <div class="oindent" role="toolbar" aria-label="Indent line">
    <button
      type="button"
      class="oindent-btn"
      data-oindent="out"
      data-action="pointerdown->outliner#keepFocus click->outliner#outdent"
      aria-label="Outdent"
      title="Outdent"
      disabled
    >
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 4h7M7 8h7M7 12h5" />
        <path d="M5 4 2 8l3 4" />
      </svg>
    </button>
    <button
      type="button"
      class="oindent-btn"
      data-oindent="in"
      data-action="pointerdown->outliner#keepFocus click->outliner#indent"
      aria-label="Indent"
      title="Indent"
      disabled
    >
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 4h7M2 8h7M2 12h5" />
        <path d="m11 4 3 4-3 4" />
      </svg>
    </button>
  </div>
  <% editor_blocks.each do |block| %>
    <div class="oblock<%= " is-bullet" unless block["bullet"] == false %>" data-block-id="<%= block["id"] %>" data-bullet="<%= block["bullet"] == false ? "0" : "1" %>" style="--depth: <%= block["indent"].to_i %>">
      <span class="obullet" aria-hidden="true"></span>
      <div class="otext" contenteditable="true" role="textbox" aria-multiline="true" spellcheck="true"><%= wiki_outliner_html(block["text"]) %></div>
    </div>
  <% end %>
</div>
<div class="tray-head">
  <% if display_label.present? %>
    <a class="tray-label" href="<%= route_bible_url(slug) %>" target="_blank" rel="noreferrer" title="Open on route.bible"><%= display_label %></a>
  <% else %>
    <p class="tray-label sr-only">Note</p>
  <% end %>
  <button
    type="button"
    class="tray-copy"
    data-action="click->reader#copyNote"
    aria-label="Copy this note"
    title="Copy note"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
      <rect x="9" y="9" width="10" height="10" rx="2"></rect>
      <path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
    </svg>
  </button>
  <button
    type="button"
    class="tray-bookmark <%= "is-on" if note&.bookmarked? %>"
    data-action="click->reader#toggleBookmark"
    aria-pressed="<%= note&.bookmarked? ? "true" : "false" %>"
    aria-label="Bookmark note"
    title="Bookmark"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 2.25h8v11.1L8 11.1 4 13.35z" />
    </svg>
  </button>
  <a
    class="tray-external"
    href="<%= route_bible_url(slug) %>"
    target="_blank"
    rel="noreferrer"
    aria-label="Open on route.bible"
    title="Open on route.bible"
  >
    <%= ph_icon("squares-four") %>
  </a>
  <button
    type="button"
    class="tray-clear"
    data-action="click->reader#clearNote"
    aria-label="Clear note"
    title="Clear note"
  >
    <%= ph_icon("trash") %>
  </button>
  <% if local_assigns[:closable] %>
    <button
      type="button"
      class="tray-close"
      data-action="click->reader#closeChapter"
      aria-label="Hide chapter note"
      title="Hide chapter note"
    >
      <%= ph_icon("x") %>
    </button>
  <% end %>
</div>
