<div class="reader-dock">
  <details class="reader-dock-menu" data-controller="dock-menu" data-action="toggle->dock-menu#closed">
    <summary class="reader-dock-btn" aria-label="Reader actions">
      <%= ph_icon("dots-three", size: 22) %>
    </summary>
    <div class="reader-dock-panel" data-action="click->dock-menu#choose">
      <%= render "reader/actions", include_recent: true %>
    </div>
  </details>
</div>
