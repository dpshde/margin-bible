# Rails
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*
/config/master.key
/config/*.key
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/vendor/bundle
/public/assets

# Legacy Elixir / Expo (if someone installs inside legacy/)
legacy/_build/
legacy/deps/
legacy/mobile/node_modules/
legacy/mobile/.expo/
legacy/mobile/dist/
legacy/packs/
legacy/node_modules/

# Hotwire Native iOS
ios/**/xcuserdata/
ios/**/DerivedData/

# Local Expo / Elixir leftovers outside legacy/
/mobile/
/_build/
/deps/
