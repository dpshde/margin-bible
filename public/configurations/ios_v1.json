{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "presentation": "default",
        "pull_to_refresh_enabled": true
      },
      "comment": "Default: web screen. Native title is the HTML <title> (chapter label)."
    },
    {
      "patterns": ["^/$"],
      "properties": {
        "presentation": "replace_root"
      },
      "comment": "Root is the notes inbox; replace the stack so it stays home."
    },
    {
      "patterns": ["^/[1-3]?[a-z]{2,3}\\.\\d+"],
      "properties": {
        "context": "default",
        "presentation": "default",
        "pull_to_refresh_enabled": true
      },
      "comment": "OSIS chapter routes (jhn.1, luk.24) advance as web screens. Title from chapter label."
    }
  ]
}
