{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "margin-bible",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "margin-bible",
      "database_id": "0f48d232-f2d8-46c2-a8a3-3b36c4279feb",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
